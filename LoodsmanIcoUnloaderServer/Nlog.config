<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<targets>
		<target
				name="logfile"
				xsi:type="File"
				fileName="\\waru16397\ElSh\SAPRLogger/${environment-user:userName=true:domain=true}/${logger}.log"
				createDirs="true"
				keepFileOpen="false"
				encoding="utf-8"
				layout="${level:uppercase=true} | ${threadid} | ${longdate:universalTime=True} | ${replace-newlines:${message}} | ${replace-newlines:${exception:format=ToString}} | ${exception:format=Data}" />
	</targets>

	<rules>
		<logger name="*" minlevel="Debug" writeTo="logfile" />
	</rules>
</nlog>